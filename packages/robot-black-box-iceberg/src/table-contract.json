{
  "contract": "rbb.iceberg.events.v1",
  "namespace": "evidence_projection",
  "table": "events",
  "format_version": 2,
  "primary_key": ["tenant_id", "run_id", "source_event_id"],
  "recommended_partitioning": ["days(event_time)", "bucket(32, tenant_id)"],
  "required_columns": [
    "projection_schema",
    "source_event_id",
    "source_event_digest",
    "source_bundle_digest",
    "tenant_id",
    "purpose_id",
    "system_id",
    "run_id",
    "stream_id",
    "sequence",
    "event_type",
    "event_time",
    "ingestion_time",
    "monotonic_ns",
    "clock_status",
    "clock_uncertainty_ms",
    "classification",
    "retention_policy_id",
    "producer_id",
    "boot_id",
    "config_digest",
    "policy_digest",
    "source_offsets_json",
    "causal_refs_json",
    "payload_digest",
    "artifact_count"
  ],
  "boundary": "Analytical projection only. The signed Robot Black Box bundle remains the evidence authority."
}
