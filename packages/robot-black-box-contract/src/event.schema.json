{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:rbb:event:1.0.0-local.1",
  "title": "Executed local single-stream synthetic replay profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1
    },
    "system_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stream_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "boot_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0.0-local.1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "event_type": {
      "enum": [
        "run.started",
        "observation.recorded",
        "proposal.recorded",
        "approval.recorded",
        "execution.observed",
        "telemetry.gap",
        "config.changed",
        "run.closed"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "monotonic_ns": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock_id",
        "status",
        "max_uncertainty_ms"
      ],
      "properties": {
        "clock_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "synchronized",
            "unsynchronized",
            "unknown"
          ]
        },
        "max_uncertainty_ms": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "mode": {
      "const": "synthetic_replay"
    },
    "causal_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_name",
        "adapter_version",
        "source_kind",
        "source_digest",
        "source_offsets",
        "claim_class"
      ],
      "properties": {
        "adapter_name": {
          "type": "string"
        },
        "adapter_version": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "source_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_offsets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_class": {
          "const": "synthetic"
        }
      }
    },
    "config_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "algorithm",
          "digest",
          "bytes",
          "media_type",
          "capture_role",
          "availability"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "algorithm": {
            "const": "sha256"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "media_type": {
            "type": "string"
          },
          "capture_role": {
            "type": "string"
          },
          "availability": {
            "enum": [
              "pending",
              "available",
              "missing",
              "deleted"
            ]
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "purpose_id",
        "retention_policy_id"
      ],
      "properties": {
        "classification": {
          "type": "string"
        },
        "purpose_id": {
          "type": "string"
        },
        "retention_policy_id": {
          "type": "string"
        }
      }
    },
    "previous_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "event_digest",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "event_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signature": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "required": [
    "event_id",
    "tenant_ref",
    "system_id",
    "run_id",
    "stream_id",
    "producer_id",
    "boot_id",
    "schema_version",
    "sequence",
    "event_type",
    "observed_at",
    "received_at",
    "monotonic_ns",
    "clock",
    "mode",
    "causal_refs",
    "provenance",
    "config_digest",
    "policy_digest",
    "payload",
    "artifact_refs",
    "privacy",
    "previous_digest",
    "authentication"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task": {
                "const": "benign_block_handover"
              },
              "required_streams": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "trust_profile": {
                "type": "string",
                "minLength": 1
              },
              "source_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "task",
              "required_streams",
              "trust_profile",
              "source_digest"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "observation.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sensor_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "string",
                "minLength": 1
              },
              "coordinate_frame": {
                "type": "string",
                "minLength": 1
              },
              "evidence_status": {
                "const": "synthetic"
              }
            },
            "required": [
              "sensor_id",
              "frame_index",
              "value",
              "units",
              "coordinate_frame",
              "evidence_status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "proposal.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "input_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "requested_scope": {
                "const": "benign_block_handover"
              },
              "model_revision": {
                "type": "string",
                "minLength": 1
              },
              "action_representation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "action_id",
              "input_refs",
              "requested_scope",
              "model_revision",
              "action_representation"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "approval.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grant": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "schema": {
                    "const": "rbb.approval.v1"
                  },
                  "decision": {
                    "enum": [
                      "allow",
                      "deny",
                      "revoke"
                    ]
                  },
                  "issuer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tenant_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "system_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "run_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "action_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nonce": {
                    "type": "string",
                    "minLength": 1
                  },
                  "config_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "policy_digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "not_before": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
                  },
                  "expires_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
                  },
                  "authentication": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "algorithm",
                      "key_id",
                      "event_digest",
                      "signature"
                    ],
                    "properties": {
                      "algorithm": {
                        "const": "ed25519"
                      },
                      "key_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "event_digest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "signature": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "required": [
                  "schema",
                  "decision",
                  "issuer",
                  "role",
                  "tenant_ref",
                  "system_id",
                  "run_id",
                  "action_id",
                  "purpose",
                  "task",
                  "nonce",
                  "config_digest",
                  "policy_digest",
                  "not_before",
                  "expires_at",
                  "authentication"
                ]
              }
            },
            "required": [
              "grant"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "execution.observed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action_id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
              },
              "task_outcome": {
                "enum": [
                  "success",
                  "failure",
                  "unknown"
                ]
              },
              "evidence_status": {
                "const": "synthetic"
              }
            },
            "required": [
              "action_id",
              "start",
              "end",
              "task_outcome",
              "evidence_status"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "telemetry.gap"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "affected_stream": {
                "type": "string",
                "minLength": 1
              },
              "missing_interval": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "origin": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "affected_stream",
              "missing_interval",
              "origin"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "config.changed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "previous_config_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "new_config_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "activated_at": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
              }
            },
            "required": [
              "previous_config_digest",
              "new_config_digest",
              "activated_at"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "run.closed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "complete",
                  "interrupted"
                ]
              },
              "event_count": {
                "type": "integer",
                "minimum": 1
              },
              "unresolved_gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "event_count",
              "unresolved_gaps"
            ]
          }
        }
      }
    }
  ]
}
