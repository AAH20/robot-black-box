{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AAH20/robot-black-box/conformance/profile.schema.json",
  "title": "Robot Black Box implementation conformance profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "implementation", "protocol_version", "event_schema_version", "assessed_at", "capabilities"],
  "properties": {
    "schema": {"const": "rbb.conformance-profile.v1"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "implementation": {"type": "string", "minLength": 1, "maxLength": 128},
    "protocol_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "event_schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "assessed_at": {"type": "string", "format": "date-time"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "limitations"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
          "status": {"enum": ["demonstrated", "limited", "not_demonstrated"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
